	# myserycord-begin : réappliqué par fluxer-myserycord-patch après chaque mise à jour.
	# Cloudflare interdit de réécrire X-Forwarded-For : on le remplace par CF-Connecting-IP
	# (posé par Cloudflare, non falsifiable). L'API lit l'IP la plus à gauche de X-Forwarded-For.
	@cf header CF-Connecting-IP *
	request_header @cf X-Forwarded-For {http.request.header.CF-Connecting-IP}

	# Badges personnalisés (service myserycord). Si le service tombe, Caddy repasse
	# directement sur l'upstream officiel (lb_policy first), sans les badges.
	handle /myserycord/* {
		reverse_proxy myserycord:8080
	}
	handle /admin/myserycord* {
		reverse_proxy myserycord:8080
	}
	handle /admin/* {
		@msc_html {
			method GET
			header Accept *text/html*
		}
		uri strip_prefix /admin
		reverse_proxy @msc_html myserycord:8080 admin:8080 {
			header_up X-Myserycord-Upstream admin
			lb_policy first
			fail_duration 30s
			lb_try_duration 2s
		}
		reverse_proxy admin:8080
	}
	@msc_app_html {
		method GET
		header Accept *text/html*
		not path /api/* /gateway* /media/* /livekit/* /admin* /web/* /emoji/* /libs/* /avatars/* /badges/* /desktop/* /.well-known/*
	}
	handle @msc_app_html {
		reverse_proxy myserycord:8080 app-proxy:8080 {
			header_up X-Myserycord-Upstream app
			lb_policy first
			fail_duration 30s
			lb_try_duration 2s
		}
	}
	# myserycord-end

