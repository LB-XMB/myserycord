#!/bin/sh
# Lancé chaque minute par fluxer-eth1-watch.timer.
# eth1 est une veth LXC : une coupure côté vmbr1 ne la passe pas "down",
# donc on teste la joignabilité de la passerelle par eth1.
# Si eth1 revient (down -> up), on recrée LiveKit.
# État lisible dans /run/fluxer-eth1.status (pour Uptime Kuma) et dans le journal.
/usr/local/sbin/fluxer-eth1-routing
STATE=/run/fluxer-eth1.status
prev=$(cut -d' ' -f1 "$STATE" 2>/dev/null)
if ping -c 2 -W 2 -I eth1 151.240.100.1 >/dev/null 2>&1; then now=up; else now=down; fi
lk=$(docker inspect -f '{{.State.Status}}' "$(cd /root/fluxer && docker compose ps -q livekit 2>/dev/null)" 2>/dev/null || echo absent)
echo "$now livekit=$lk $(date -Is)" > "$STATE"
[ "$now" != "$prev" ] && logger -t fluxer-eth1 "eth1 $prev -> $now (livekit=$lk)"
if [ "$prev" = down ] && [ "$now" = up ]; then
	cd /root/fluxer && docker compose up -d --force-recreate livekit >/dev/null 2>&1
	logger -t fluxer-eth1 "livekit recréé"
fi
exit 0
