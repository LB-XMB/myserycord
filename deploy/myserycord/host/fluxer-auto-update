#!/bin/sh
# Met à jour Fluxer sur la dernière version officielle (install.sh --update fait
# une sauvegarde base + uploads, pull, recrée et vérifie), puis réapplique le
# correctif CF-Connecting-IP du Caddyfile, que --update écrase.
set -eu
cd /root/fluxer
work=$(mktemp -d); trap "rm -rf $work" EXIT
curl -fsSL --proto =https -o "$work/install.sh" https://fluxer.dev/install.sh
curl -fsSL --proto =https -o "$work/install.sh.sha256" https://fluxer.dev/install.sh.sha256
[ "$(sha256sum "$work/install.sh" | cut -d" " -f1)" = "$(cut -d" " -f1 "$work/install.sh.sha256")" ] || { echo "checksum install.sh KO"; exit 1; }
cp "$work/install.sh" /root/fluxer-install/install.sh
sh /root/fluxer-install/install.sh --update --non-interactive --allow-root --dir /root/fluxer

if ! grep -q "CF-Connecting-IP" Caddyfile; then
	python3 - <<"PY"
p="/root/fluxer/Caddyfile"; s=open(p).read()
a="{$FLUXER_EDGE_SITE_ADDRESS} {\n"
b=a+"\t# Myserycord: X-Forwarded-For remplacé par CF-Connecting-IP (anti-usurpation d IP).\n\t@cf header CF-Connecting-IP *\n\trequest_header @cf X-Forwarded-For {http.request.header.CF-Connecting-IP}\n\n"
assert s.count(a)==1, "ancre Caddyfile introuvable"
open(p,"w").write(s.replace(a,b))
PY
	docker compose restart edge
	echo "Caddyfile: correctif CF-Connecting-IP réappliqué"
fi
sleep 15
curl -fsS -o /dev/null http://192.168.1.50:8080/_health && echo "edge OK"
